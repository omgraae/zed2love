-- Interactive playground example demonstrating:
-- 1. Virtual 16:9 coordinate space (1600x900) via `lovemap.aspect(16, 9)`
-- 2. Full-screen post-processing shader chain (`lovemap.setShaders("crt", "scanlines", "vignette")`)
-- 3. Per-object / per-group parameterized shaders (`lovemap.newEffect` + `lovemap.withEffect`)
-- 4. Automatic F11 fullscreen toggle, ESC exit fullscreen, and `function lovemap.draw()`

local lovemap = require("src.lovemap")

local spiller
local mus
local player_fx
local time_elapsed = 0

function love.load()
    love.window.setTitle("zed2love — Playground & Shader Demo")

    -- 16:9 aspect ratio -> 1600x900 virtual game coordinates regardless of window resolution
    lovemap.aspect(16, 9)

    -- 1. Full-screen shader chain (embedded vrld/moonshine effects)
    local screen_fx = lovemap.setShaders("crt", "scanlines", "vignette")
    screen_fx.scanlines.opacity = 0.25
    screen_fx.vignette.opacity = 0.35

    -- 2. Per-object shader effect (chromatic aberration + glow only on the player/cursor group)
    player_fx = lovemap.newEffect("chromasep", "glow")
    player_fx.glow.min_luma = 0.3
    player_fx.glow.strength = 6

    spiller = {
        x = 800,
        y = 450,
        bredde = 50,
        hoejde = 70,
        hastighed = 550,
        acceleration = 14,
        fartx = 0,
        farty = 0,
    }

    mus = { x = 800, y = 450 }
end

function love.update(dt)
    time_elapsed = time_elapsed + dt

    if love.keyboard.isDown("right") or love.keyboard.isDown("d") then
        spiller.x = spiller.x + spiller.hastighed * dt
    end
    if love.keyboard.isDown("up") or love.keyboard.isDown("w") then
        spiller.y = spiller.y - spiller.hastighed * dt
    end
    if love.keyboard.isDown("down") or love.keyboard.isDown("s") then
        spiller.y = spiller.y + spiller.hastighed * dt
    end
    if love.keyboard.isDown("left") or love.keyboard.isDown("a") then
        spiller.x = spiller.x - spiller.hastighed * dt
    end

    -- Mouse position in virtual 1600x900 coordinates
    mus.x, mus.y = lovemap.getMousePosition(true)

    if love.mouse.isDown(1) then
        local a = mus.y - spiller.y
        local b = mus.x - spiller.x
        local c = math.sqrt(a * a + b * b)
        if c > 0.001 then
            spiller.farty = math.max(-spiller.hastighed, math.min(spiller.hastighed, spiller.farty + a * spiller.acceleration / c))
            spiller.fartx = math.max(-spiller.hastighed, math.min(spiller.hastighed, spiller.fartx + b * spiller.acceleration / c))
            local vy = a * spiller.farty / c
            local vx = b * spiller.fartx / c
            spiller.y = spiller.y + vy * dt
            spiller.x = spiller.x + vx * dt
        end
    end
end

function lovemap.draw()
    -- Scene background frame & HUD (unaffected by the per-object player_fx shader)
    love.graphics.setColor(0.25, 0.35, 0.55, 1.0)
    love.graphics.setLineWidth(4)
    love.graphics.rectangle("line", 20, 20, lovemap.width - 40, lovemap.height - 40)

    love.graphics.setColor(0.85, 0.90, 1.0, 1.0)
    love.graphics.print("WASD / Arrows / Left-Click to move | F11: Fullscreen | ESC: Exit Fullscreen", 45, 40)

    -- Apply dynamic, parameterized shader effect ONLY to the player and target cursor
    local dynamic_radius = 4 + math.sin(time_elapsed * 4) * 3
    lovemap.withEffect(player_fx, {
        chromasep = {
            angle = time_elapsed * 2,
            radius = dynamic_radius,
        },
    }, function()
        love.graphics.setColor(0.2, 0.7, 1.0, 1.0)
        love.graphics.rectangle("fill", spiller.x, spiller.y, spiller.bredde, spiller.hoejde)

        love.graphics.setColor(1.0, 0.45, 0.25, 1.0)
        love.graphics.circle("line", mus.x, mus.y, 18)
    end)
end
